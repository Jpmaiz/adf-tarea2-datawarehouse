{
	"name": "df_bronze_to_silver_vacunaciones",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_vacunacion_santa_cruz",
						"type": "DatasetReference"
					},
					"name": "SantaCruz"
				},
				{
					"dataset": {
						"referenceName": "ds_bronze_vacunacion_rural_movil",
						"type": "DatasetReference"
					},
					"name": "Movil"
				},
				{
					"dataset": {
						"referenceName": "ds_bronze_vacunacion_la_paz",
						"type": "DatasetReference"
					},
					"name": "LaPaz"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_vacunaciones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				},
				{
					"name": "derivedColumn7"
				},
				{
					"name": "union1"
				},
				{
					"name": "union2"
				},
				{
					"name": "derivedColumn8"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as boolean,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as short,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as double,",
				"          edad_dias_aplicacion as short,",
				"          aplicacion_oportuna as boolean,",
				"          via_administracion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SantaCruz",
				"source(output(",
				"          record_id as string,",
				"          sync_timestamp as string,",
				"          device_id as string,",
				"          patient_id as string,",
				"          patient_ci as string,",
				"          patient_name as string,",
				"          patient_last_name_1 as string,",
				"          patient_last_name_2 as string,",
				"          patient_sex as string,",
				"          patient_birth_date as string,",
				"          patient_department as string,",
				"          patient_municipality as string,",
				"          patient_community as string,",
				"          patient_indigenous as string,",
				"          vaccination_date as string,",
				"          vaccine_code as string,",
				"          vaccine_name as string,",
				"          dose_number as string,",
				"          facility_code as string,",
				"          facility_name as string,",
				"          lot_number as string,",
				"          storage_temp_celsius as string,",
				"          patient_age_days as string,",
				"          administration_route as string,",
				"          gps_latitude as string,",
				"          gps_longitude as string,",
				"          gps_accuracy_meters as string,",
				"          observations as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Movil",
				"source(output(",
				"          id_registro as string,",
				"          cod_paciente as string,",
				"          documento_identidad as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          genero as string,",
				"          fec_nacimiento as string,",
				"          municipio as string,",
				"          pueblo_indigena as string,",
				"          fec_vacunacion as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as string,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          depto as string,",
				"          nro_lote as string,",
				"          temp_conservacion as string,",
				"          edad_dias as string,",
				"          via_aplicacion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> LaPaz",
				"SantaCruz select(mapColumn(",
				"          registro_id,",
				"          paciente_id,",
				"          ci_paciente,",
				"          nombre_paciente,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          sexo,",
				"          fecha_nacimiento,",
				"          municipio_residencia,",
				"          comunidad_indigena,",
				"          fecha_vacunacion,",
				"          vacuna_id,",
				"          vacuna_nombre,",
				"          numero_dosis,",
				"          establecimiento_id,",
				"          nombre_establecimiento,",
				"          departamento,",
				"          lote_vacuna,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          via_administracion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"Movil select(mapColumn(",
				"          registro_id = record_id,",
				"          paciente_id = patient_id,",
				"          ci_paciente = patient_ci,",
				"          nombre_paciente = patient_name,",
				"          apellido_paterno = patient_last_name_1,",
				"          apellido_materno = patient_last_name_2,",
				"          sexo = patient_sex,",
				"          fecha_nacimiento = patient_birth_date,",
				"          departamento = patient_department,",
				"          municipio_residencia = patient_municipality,",
				"          comunidad_indigena = patient_indigenous,",
				"          fecha_vacunacion = vaccination_date,",
				"          vacuna_id = vaccine_code,",
				"          vacuna_nombre = vaccine_name,",
				"          numero_dosis = dose_number,",
				"          establecimiento_id = facility_code,",
				"          nombre_establecimiento = facility_name,",
				"          lote_vacuna = lot_number,",
				"          temperatura_conservacion = storage_temp_celsius,",
				"          edad_dias_aplicacion = patient_age_days,",
				"          via_administracion = administration_route",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"LaPaz select(mapColumn(",
				"          registro_id = id_registro,",
				"          paciente_id = cod_paciente,",
				"          ci_paciente = documento_identidad,",
				"          nombre_paciente = nombres,",
				"          apellido_paterno = primer_apellido,",
				"          apellido_materno = segundo_apellido,",
				"          sexo = genero,",
				"          fecha_nacimiento = fec_nacimiento,",
				"          municipio_residencia = municipio,",
				"          comunidad_indigena = pueblo_indigena,",
				"          fecha_vacunacion = fec_vacunacion,",
				"          vacuna_id = cod_vacuna,",
				"          vacuna_nombre = desc_vacuna,",
				"          numero_dosis = nro_dosis,",
				"          establecimiento_id = cod_establecimiento,",
				"          nombre_establecimiento = desc_establecimiento,",
				"          departamento = depto,",
				"          lote_vacuna = nro_lote,",
				"          temperatura_conservacion = temp_conservacion,",
				"          edad_dias_aplicacion = edad_dias,",
				"          via_administracion = via_aplicacion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1 derive(fecha_nacimiento =  toDate(toString(fecha_nacimiento), 'dd/MM/yyyy'),",
				"          fecha_vacunacion = iif(\r",
				"  startsWith(trim(toString(fecha_vacunacion)), '00/'),\r",
				"  toDate(null()),\r",
				"  toDate(trim(toString(fecha_vacunacion)), 'dd/MM/yyyy')\r",
				")) ~> derivedColumn1",
				"select2 derive(fecha_nacimiento = toDate(toString(fecha_nacimiento), 'yyyy-MM-dd'),",
				"          fecha_vacunacion = toDate(substring(toString(fecha_vacunacion), 1, 10), 'yyyy-MM-dd')) ~> derivedColumn2",
				"select3 derive(fecha_nacimiento = toDate(toString(fecha_nacimiento), 'dd/MM/yyyy'),",
				"          fecha_vacunacion = toDate(toString(fecha_vacunacion), 'dd/MM/yyyy')) ~> derivedColumn3",
				"derivedColumn3 derive(sexo = case(   upper(trim(toString(sexo))) == 'MASCULINO', 'M',   upper(trim(toString(sexo))) == 'FEMENINO', 'F',   upper(trim(toString(sexo))) == 'M', 'M',   upper(trim(toString(sexo))) == 'F', 'F',   'NO ESPECIFICADO' )) ~> derivedColumn4",
				"derivedColumn1 derive(comunidad_indigena = case(   upper(trim(toString(comunidad_indigena))) == 'SÍ', 'SI',   upper(trim(toString(comunidad_indigena))) == 'SI', 'SI',   upper(trim(toString(comunidad_indigena))) == 'TRUE', 'SI',   upper(trim(toString(comunidad_indigena))) == '✔', 'SI',   upper(trim(toString(comunidad_indigena))) == '✓', 'SI',   upper(trim(toString(comunidad_indigena))) == 'NO', 'NO',   upper(trim(toString(comunidad_indigena))) == 'FALSE', 'NO',   upper(trim(toString(comunidad_indigena))) == '✘', 'NO',   upper(trim(toString(comunidad_indigena))) == '✗', 'NO',   'NO ESPECIFICADO' ),",
				"          numero_dosis = trim(toString(numero_dosis)),",
				"          temperatura_conservacion = trim(toString(temperatura_conservacion)),",
				"          edad_dias_aplicacion = trim(toString(edad_dias_aplicacion))) ~> derivedColumn5",
				"derivedColumn2 derive(comunidad_indigena = case(   upper(trim(toString(comunidad_indigena))) == 'SÍ', 'SI',   upper(trim(toString(comunidad_indigena))) == 'SI', 'SI',   upper(trim(toString(comunidad_indigena))) == 'TRUE', 'SI',   upper(trim(toString(comunidad_indigena))) == '✔', 'SI',   upper(trim(toString(comunidad_indigena))) == '✓', 'SI',   upper(trim(toString(comunidad_indigena))) == 'NO', 'NO',   upper(trim(toString(comunidad_indigena))) == 'FALSE', 'NO',   upper(trim(toString(comunidad_indigena))) == '✘', 'NO',   upper(trim(toString(comunidad_indigena))) == '✗', 'NO',   'NO ESPECIFICADO' ),",
				"          edad_dias_aplicacion = trim(toString(edad_dias_aplicacion)),",
				"          temperatura_conservacion = trim(toString(temperatura_conservacion)),",
				"          numero_dosis = trim(toString(numero_dosis))) ~> derivedColumn6",
				"derivedColumn4 derive(comunidad_indigena = case(   upper(trim(toString(comunidad_indigena))) == 'SÍ', 'SI',   upper(trim(toString(comunidad_indigena))) == 'SI', 'SI',   upper(trim(toString(comunidad_indigena))) == 'TRUE', 'SI',   upper(trim(toString(comunidad_indigena))) == '✔', 'SI',   upper(trim(toString(comunidad_indigena))) == '✓', 'SI',   upper(trim(toString(comunidad_indigena))) == 'NO', 'NO',   upper(trim(toString(comunidad_indigena))) == 'FALSE', 'NO',   upper(trim(toString(comunidad_indigena))) == '✘', 'NO',   upper(trim(toString(comunidad_indigena))) == '✗', 'NO',   'NO ESPECIFICADO' ),",
				"          numero_dosis = trim(toString(numero_dosis)),",
				"          temperatura_conservacion = trim(toString(temperatura_conservacion)),",
				"          edad_dias_aplicacion = trim(toString(edad_dias_aplicacion))) ~> derivedColumn7",
				"derivedColumn5, derivedColumn6 union(byName: true)~> union1",
				"union1, derivedColumn7 union(byName: true)~> union2",
				"union2 derive(fecha_nacimiento = iif(isNull(fecha_nacimiento) || trim(toString(fecha_nacimiento)) == '', 'SIN FECHA', trim(toString(fecha_nacimiento))),",
				"          fecha_vacunacion = iif(isNull(fecha_vacunacion) || trim(toString(fecha_vacunacion)) == '', 'SIN FECHA', trim(toString(fecha_vacunacion))),",
				"          ci_paciente = iif(   isNull(ci_paciente) || trim(toString(ci_paciente)) == '',   'SIN CI',   upper(trim(toString(ci_paciente))) )) ~> derivedColumn8",
				"derivedColumn8 select(mapColumn(",
				"          id_registro = registro_id,",
				"          cod_paciente = paciente_id,",
				"          ci_paciente,",
				"          nombre_paciente,",
				"          apellido_paterno,",
				"          apellido_materno,",
				"          genero = sexo,",
				"          fec_nacimiento = fecha_nacimiento,",
				"          municipio_residencia,",
				"          pueblo_indigena = comunidad_indigena,",
				"          fec_vacunacion = fecha_vacunacion,",
				"          cod_vacuna = vacuna_id,",
				"          desc_vacuna = vacuna_nombre,",
				"          nro_dosis = numero_dosis,",
				"          cod_establecimiento = establecimiento_id,",
				"          desc_establecimiento = nombre_establecimiento,",
				"          departamento,",
				"          nro_lote = lote_vacuna,",
				"          temp_conservacion = temperatura_conservacion,",
				"          edad_dias = edad_dias_aplicacion,",
				"          via_aplicacion = via_administracion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_registro as string,",
				"          origen as string,",
				"          cod_paciente as string,",
				"          genero as string,",
				"          fec_nacimiento as date,",
				"          edad_dias as integer,",
				"          municipio_residencia as string,",
				"          pueblo_indigena as string,",
				"          comunidad as string,",
				"          fec_vacunacion as date,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as integer,",
				"          via_aplicacion as string,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          departamento as string,",
				"          nro_lote as string,",
				"          temp_conservacion as decimal(5,2),",
				"          gps_latitud as decimal(9,6),",
				"          gps_longitud as decimal(9,6),",
				"          gps_precision_metros as decimal(8,2),",
				"          observaciones as string,",
				"          fecha_carga as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}